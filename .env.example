# ─────────────────────────────────────────────────────────────
# prima-pool-client — worker agent + prima.cpp (single container)
# Copy to .env and edit. Deployed by each PROVIDER on their device.
# ─────────────────────────────────────────────────────────────

# URL of the pool operator's control plane (required).
# e.g. https://pool.example.com
PRIMA_POOL_URL=http://127.0.0.1:8000

# Worker-scoped API key (required) — from `prima-pool-client bootstrap`
# against the operator's server.
PRIMA_POOL_API_KEY=

# Model to serve + self-declared memory (MB)
PRIMA_POOL_MODEL=demo-model
PRIMA_POOL_MEMORY_MB=4096

# WireGuard (leave private key empty to auto-generate on first run)
PRIMA_POOL_WG_PRIVATE_KEY=
PRIMA_POOL_WG_LISTEN_PORT=51820
PRIMA_POOL_WG_INTERFACE=prima-pool
# Where the WG config file is written inside the container.
PRIMA_POOL_WG_CONF_DIR=/etc/wireguard
# Explicit WG endpoint host advertised at registration (public IP, Tailscale IP,
# or hostname). Empty = the server uses the IP it observes on the registration
# connection (recommended when behind NAT / in a container).
PRIMA_POOL_WG_ENDPOINT_HOST=
# Seconds between direct→relay fallback health checks (default 10). When a
# direct WG handshake fails, the client routes unreachable peers via the relay.
PRIMA_POOL_WG_RELAY_CHECK_S=10

# prima.cpp launch: "same-container" (default, exec in this container)
# or "docker" (legacy, docker compose against a mounted prima-docker project).
PRIMA_POOL_PRIMA_MODE=same-container
# prima-docker project dir (docker mode only).
PRIMA_POOL_PRIMA_DIR=~/prima
# GGUF filename (used by the PRIMA_POOL_MODEL_PATH fallback + docker mode).
PRIMA_POOL_MODEL_FILE=model.gguf
# Absolute path to the GGUF model inside the container.
PRIMA_POOL_MODEL_PATH=/models/model.gguf
PRIMA_POOL_MEM_LIMIT=8g
PRIMA_POOL_GPU_MEM_FLAG=
PRIMA_POOL_CTX_SIZE=4096
PRIMA_POOL_API_PORT=8080
PRIMA_POOL_BATCH_FLAGS=
PRIMA_POOL_EXTRA_FLAGS=

# ── Agent state ────────────────────────────────────────────
# Where the agent persists its worker state (worker_id, WG keypair).
PRIMA_POOL_STATE_PATH=~/.local/state/prima-pool/client-state.json

# ── Build-time (docker compose build) ───────────────────────
# Set CUDA=1 to build a GPU image (requires nvidia runtime).
CUDA=0
# OPTIONAL opt-in: URL to bake a SMALL model into the image at build time.
# Leave empty (default) to mount the model from the host instead — baking a
# 30-70B GGUF (20-40+ GB) into the image is not recommended.
MODEL_URL=

# ── Host paths (compose) ────────────────────────────────────
# DEFAULT: host directory containing the GGUF, mounted read-only into the
# container at /models. Put the model file here (e.g. ./models/model.gguf).
PRIMA_POOL_MODEL_DIR=./models
